# The same style as ../libp2p-ffi: four spaces, 100 columns, a function's brace on its own line
# and everything else's attached.
BasedOnStyle: LLVM

IndentWidth: 4
UseTab: Never
TabWidth: 4

ColumnLimit: 100

BreakBeforeBraces: Linux
AlignAfterOpenBracket: Align
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: false
AllowShortFunctionsOnASingleLine: false

# The comments in this project carry the reasoning and are wrapped by hand where the wrap says
# something. Reflowing them would run the paragraphs back together.
ReflowComments: false
SortIncludes: true
